        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "location",
        "x",
        "y",
        "items",
        "note"
      ],
      "additionalProperties": false

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lsiddd/stardew-compass/schema/report-v2.json",
  "title": "Stardew analysis report v2",
  "$ref": "#/$defs/AnalysisResult",
  "$defs": {
    "AnalysisResult": {
      "type": "object",
      "properties": {
        "save_file": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/SaveMetadata"
        },
        "progress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgressResult"
          }
        },
        "predictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PredictionSection"
          }
        },
        "bubbles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BubbleEvent"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactResult"
          }
        },
        "extras": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtrasResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "schema_version": {
          "const": 2
        }
      },
      "required": [
        "save_file",
        "metadata",
        "progress",
        "predictions",
        "bubbles",
        "artifacts",
        "extras",
        "diagnostics",
        "provenance",
        "schema_version"
      ],
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "feature": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "feature",
        "message",
        "severity"
      ],
      "additionalProperties": false
    },
    "ShippedItem": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "name",
        "quantity"
      ],
      "additionalProperties": false
    },
    "ExtrasPlayer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "player_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemState"
          }
        },
        "equipment": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ItemState"
            }
          }
        },
        "experience": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "shipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShippedItem"
          }
        }
      },
      "required": [
        "name",
        "player_id",
        "inventory",
        "equipment",
        "experience",
        "skills",
        "shipped"
      ],
      "additionalProperties": false
    },
    "ExtrasResult": {
      "type": "object",
      "properties": {
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExtrasPlayer"
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContainerState"
          }
        },
        "shared_inventories": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ItemState"
            }
          }
        },
        "rarecrows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "animals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnimalState"
          }
        },
        "perfection_waivers": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "players",
        "containers",
        "shared_inventories",
        "rarecrows",
        "animals",
        "perfection_waivers"
      ],
      "additionalProperties": false
    },
    "SaveMetadata": {
      "type": "object",
      "properties": {
        "game_id": {
          "type": "integer"
        },
        "game_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "season": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "days_played": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "use_legacy_random": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "farm_type": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "daily_luck": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "game_id",
        "game_version",
        "year",
        "season",
        "day",
        "days_played",
        "use_legacy_random",
        "farm_type",
        "daily_luck"
      ],
      "additionalProperties": false
    },
    "ItemState": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "integer"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_recipe": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "big_craftable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemState"
          }
        },
        "enchantments": {
          "type": "array",
          "items": {
            "type": "string"
          },

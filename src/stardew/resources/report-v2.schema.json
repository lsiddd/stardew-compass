        },
        "location": {
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "y": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemState"
          }

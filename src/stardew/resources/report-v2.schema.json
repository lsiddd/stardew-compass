              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "scenario": {
          "type": ["string", "null"],
          "description": "Session-dependent frenzy decisions required for this event; null if shared by every forecast scenario."
        }
      },
      "required": [
        "location",
        "x",
        "y",
        "start",
        "end",
        "kind"
      ],
      "additionalProperties": false
    },
    "DigItem": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "integer"
        },
        "runtime_dependent": {
          "type": "boolean"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "item_id",
        "name",
        "quantity",
        "runtime_dependent",
        "alternatives"
      ],
      "additionalProperties": false
    },
    "ArtifactResult": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string"
        },
        "x": {
          "type": "integer"
        },
